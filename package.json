{
	"name": "obsidian-sample-plugin",
	"version": "1.0.6",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build:css": "lessc style.less styles.css",
		"dev:css": "lessc --watch style.less styles.css",
		"dev": "concurrently \"node esbuild.config.mjs\" \"npm run dev:css\"",
		"build": "tsc -noEmit -skipLibCheck && npm run build:css && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"concurrently": "9.1.2",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"less": "4.2.2",
		"lucide-static": "^0.460.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"monkey-around": "^3.0.0",
		"obsidian": "latest"
	}
}
